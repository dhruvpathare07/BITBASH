# Copy this file to .env (which is gitignored) and fill in real values.
# backend/.env is loaded automatically on startup.

# Admin panel passkey (checked server-side). REQUIRED to use /admin.
# Choose your own; do not commit the real value.
ADMIN_PASSKEY=your-passkey-here

# Leave unset to use local SQLite (backend/results.db).
# In production (e.g. Vercel) set a PostgreSQL URL, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated allowed frontend origins (CORS). Example for prod:
# ALLOWED_ORIGINS=https://your-app.vercel.app
